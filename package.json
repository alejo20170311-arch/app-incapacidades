{
  "name": "recobro-incapacidades-colombia",
  "version": "0.1.0",
  "description": "Aplicacion local para gestion y recobro de incapacidades laborales en Colombia.",
  "main": "electron/main.js",
  "author": "ETERNA",
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dev:web": "concurrently -k \"node server.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "serve:web": "npm run build && node server.js",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis",
    "lint": "node --check electron/main.js && node --check electron/preload.js && node --check electron/db.js && node --check electron/importer.js && node --check electron/payments.js && node --check electron/reports.js && node --check server.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.2",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "express": "^5.2.1",
    "lucide-react": "^0.561.0",
    "multer": "^2.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.6.0",
    "sql.js": "^1.13.0",
    "vite": "^7.3.0",
    "wait-on": "^9.0.3",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "co.eterna.recobroincapacidades",
    "productName": "Recobro Incapacidades",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "gh-pages": "^6.3.0"
  }
}
